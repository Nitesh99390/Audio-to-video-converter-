# ---- REQUIRED (from https://my.telegram.org and @BotFather) ----
API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=123456:ABC-DEF...

# ---- Owner / admins ----
OWNER_ID=6069200310        # receives every access request with one-tap approve buttons
ADMINS=                    # extra admin ids, space/comma separated

# ---- Approval system ----
ACCESS_REQUIRED=true       # true = users must be approved by the owner (1h / 2h / 5h / 10h / ... / permanent)
REQUEST_COOLDOWN_MIN=10    # minutes before a rejected/expired user may request again

# ---- Optional channels ----
LOG_CHANNEL=0              # -100xxxxxxxxxx : every generated video is copied here
FORCE_SUB_CHANNEL=         # @channel or -100id ; bot must be admin there
SUPPORT_LINK=
UPDATES_LINK=

# ---- Limits ----
MAX_FILE_SIZE_MB=2000
MAX_AUDIO_DURATION_SEC=86400
MAX_OUTPUT_DURATION_SEC=86400   # 24 h
MAX_OUTPUT_SIZE_MB=1950         # Telegram bot upload cap
MAX_CONCURRENT_TASKS=2
MAX_SLIDESHOW_IMAGES=20
DAILY_LIMIT_FREE=0              # 0 = unlimited (approval is the gate)
FFMPEG_THREADS=0                # 0 = auto

# ---- Feature policy ----
PRO_ENGINE_ADMIN_ONLY=true      # Pro engine (effects / 4K / full re-encode) only for admins; everyone else = Lite

# ---- Storage guard (Kaggle / Colab: ~20 GB scratch disk, notebook crashes when full) ----
MAX_STORAGE_MB=6000             # quota for the work folder; idle uploads are evicted oldest-first above this
MIN_FREE_MB=1500                # always keep this much disk free (emergency eviction below it)
SESSION_TTL_SEC=2700            # uploads that are not converted within 45 min are deleted
ORPHAN_TTL_SEC=600              # files no session / job owns are deleted after 10 min
CLEANUP_INTERVAL_SEC=180        # how often the disk watchdog runs

# ---- Lite engine ----
LITE_SEGMENT_SEC=60             # length of the pre-rendered loop segment
LITE_MAX_BG_VIDEO_SEC=600       # max seconds of a background video used for the loop

# ---- Intro / Outro ----
MAX_INTRO_OUTRO_SEC=300         # max length of an intro or outro clip (5 min)
INTRO_OUTRO_AUTO_SEC=90         # a video longer than this, sent while no photo is set, becomes the background loop

# ---- Misc ----
BOT_NAME=Audio → Video Bot
DEFAULT_CAPTION=🎬 Made with {bot_name}
DOWNLOAD_DIR=downloads
DB_PATH=bot_data.db

# ---- YouTube upload (admins only) ----
YT_UPLOAD_ENABLED=true          # after a render, admins are asked "Upload to YouTube?"
YT_TOKEN_DIR=data/yt_tokens     # where the admin's token.pickle is kept (outside downloads/, never auto-deleted)
YT_PENDING_TTL_SEC=1800         # how long a finished video waits for the upload decision (30 min)
YT_DEFAULT_PRIVACY=public       # public / unlisted / private
YT_DEFAULT_TEMPLATE=music       # SEO template: sleep / lofi / meditation / music / study / plain
YT_DEFAULT_CATEGORY=10          # 10 Music · 22 People & Blogs · 24 Entertainment · 26 Howto
YT_CHUNK_MB=32                  # resumable upload chunk size
YT_CHANNEL_NAME=                # appended to descriptions / tags (optional)
YT_EXTRA_TAGS=                  # comma separated extra tags for every upload (optional)
