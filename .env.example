# ---- REQUIRED (from https://my.telegram.org and @BotFather) ----
API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=123456:ABC-DEF...

# ---- Owner / admins ----
OWNER_ID=6069200310        # receives every access request with one-tap approve buttons
ADMINS=                    # extra admin ids, space/comma separated

# ---- Approval system ----
ACCESS_REQUIRED=true       # true = users must be approved by the owner (1h / 2h / 5h / 10h / ... / permanent)
REQUEST_COOLDOWN_MIN=10    # minutes before a rejected/expired user may request again

# ---- Optional channels ----
LOG_CHANNEL=0              # -100xxxxxxxxxx : every generated video is copied here
FORCE_SUB_CHANNEL=         # @channel or -100id ; bot must be admin there
SUPPORT_LINK=
UPDATES_LINK=

# ---- Limits ----
MAX_FILE_SIZE_MB=2000
MAX_AUDIO_DURATION_SEC=86400
MAX_OUTPUT_DURATION_SEC=86400   # 24 h
MAX_OUTPUT_SIZE_MB=1950         # Telegram bot upload cap
MAX_CONCURRENT_TASKS=2
MAX_SLIDESHOW_IMAGES=20
DAILY_LIMIT_FREE=0              # 0 = unlimited (approval is the gate)
FFMPEG_THREADS=0                # 0 = auto

# ---- Lite engine ----
LITE_SEGMENT_SEC=60             # length of the pre-rendered loop segment
LITE_MAX_BG_VIDEO_SEC=600       # max seconds of a background video used for the loop

# ---- Misc ----
BOT_NAME=Audio → Video Bot
DEFAULT_CAPTION=🎬 Made with {bot_name}
DOWNLOAD_DIR=downloads
DB_PATH=bot_data.db
